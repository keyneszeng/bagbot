# BagBot configuration
# Copy to .env and fill in.

# ─── Orbio / Wallet ─────────────────────────────────────────
# Your Robinhood Chain wallet address that holds $ORBIO.
# Example: 0xAa07A0e9209e16aC99708C3EC70159c6eF3128A3 (do not use this; it's Orbio's contract)
ORBIO_WALLET=

# Optional: a human-readable label (used in notifications)
WALLET_LABEL=My Main Wallet

# ─── Orbio MCP ──────────────────────────────────────────────
# The MCP endpoint. Default is correct unless Orbio moves it.
ORBIO_MCP_URL=https://www.orbio.so/api/mcp
# OAuth bearer used by the MCP client. Obtained via the /mcp sign-in flow in Claude Code
# (or any MCP client). Keep this secret — it can claim keys on your behalf.
ORBIO_MCP_TOKEN=

# ─── Daemon policy ──────────────────────────────────────────
# How often to poll the balance (seconds). 300 = 5 min.
POLL_INTERVAL_SEC=300

# When the spendable balance drops below this USD (with a healthy key),
# BagBot alerts you to hold more $ORBIO.
LOW_BALANCE_USD=5.00

# Recreate (rotate) the key once it is older than N hours (0 = disable).
ROTATE_MAX_AGE_HOURS=168

# REVOKE the key (suspected leak) when the balance burn rate exceeds
# N USD/hour. In the gateway model the balance curve IS the spend curve.
ROTATE_BURST_USD_PER_HOUR=20.00

# State DB path.
STATE_DB_PATH=./data/bagbot.sqlite

# Log file.
LOG_FILE=./data/bagbot.log
LOG_LEVEL=INFO

# ─── Notifier: WeChat Work / 公众号 ──────────────────────────
# See docs/guide.zh-CN.md for how to obtain these.
WECHAT_ENABLED=false
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=

# ─── Notifier: Feishu / Lark ────────────────────────────────
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# ─── Notifier: Generic Webhook (Slack / Discord / DingTalk) ─
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ─── Notifier: Email (SMTP) ─────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ─── Dashboard ──────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_ENABLED=true
# Shared secret required for POST /api/claim|rotate|topup.
# Leave empty to keep the dashboard read-only (recommended default).
# If you bind to 0.0.0.0 or expose the port, you MUST set a strong token.
DASHBOARD_TOKEN=

# ─── Locale ─────────────────────────────────────────────────
LANGUAGE=zh-CN  # zh-CN | en
TIMEZONE=Asia/Shanghai
