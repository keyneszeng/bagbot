# BagBot skill — minimal config
# Copy to your environment or .env. All values are placeholders.

# ─── Required ─────────────────────────────────────────────────────
# Wallet that holds >=1,000 $ORBIO on Robinhood Chain.
ORBIO_WALLET=0xYourRobinhoodChainWalletAddress
# Bearer token obtained from orbio.so or the Orbio MCP sign-in flow.
ORBIO_MCP_TOKEN=replace-with-your-orbio-mcp-bearer-token

# ─── Optional: MCP endpoint ───────────────────────────────────────
# ORBIO_MCP_URL=https://www.orbio.so/api/mcp

# ─── Optional: policy knobs ───────────────────────────────────────
# LOW_BALANCE_USD=5.0
# TOPUP_THRESHOLD=0.80
# ROTATE_MAX_AGE_HOURS=168
# ROTATE_BURST_USD_PER_HOUR=20.0
# KEY_CAP_USD=200.0
# LANGUAGE=zh-CN

# ─── Optional: notifiers ──────────────────────────────────────────
# Feishu / Lark robot webhook (+ secret if signing enabled)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_SECRET=
# Generic webhook (Slack / Discord / DingTalk style)
# WEBHOOK_URL=
# SMTP email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=
